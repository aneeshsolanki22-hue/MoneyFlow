{
  "expo": {
    "name": "moneyflow",
    "slug": "moneyflow",
    "version": "1.0.1",
    "scheme": "moneyfollowbrother",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0E",
    "updates": {
      "url": "https://u.expo.dev/7463ad7f-afef-4842-86d7-53a93ce07928"
    },
    "runtimeVersion": "84f03024885a006328f1d71db0b5c412c52eefdb",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.toukirsolanki.moneyflow",
      "permissions": [
        "android.permission.VIBRATE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0B0B12",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-foreground.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0E"
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-updates",
      [
        "expo-navigation-bar",
        {
          "hidden": true,
          "style": "light"
        }
      ],
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "abiFilters": ["arm64-v8a"]
          }
        }
      ]
    ],
    "extra": {
      "googleClientIds": {
        "webClientId": "510345420972-0nn2i4nr2acve0etqnda0cf5rjetf8sv.apps.googleusercontent.com",
        "androidClientId": "510345420972-4ovirqobh4unkmv1h1rh7elibihvhs62.apps.googleusercontent.com"
      },
      "eas": {
        "projectId": "7463ad7f-afef-4842-86d7-53a93ce07928"
      },
      "expo-navigation-bar": {
        "style": "light",
        "hidden": true
      }
    },
    "owner": "toukir-solanki"
  }
}
